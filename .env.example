# --- Puertos ---
ENGINE_API_PORT=3050
ENGINE_UI_PORT=3051
LLAMA_HOST_PORT=8080
TRAINER_PORT=8081
AGENT_PORT=3060
AGENT_UI_PORT=3061

# --- Seguridad (cambiá en producción) ---
ENGINE_API_KEY=llama-engine-dev

# --- GPU ---
LLAMA_GPU_DEVICE=all

# --- Runtime llama.cpp ---
LLAMA_MODEL=qwen3.5-4b
LLAMA_MMPROJ=auto
LLAMA_NGPU=999
LLAMA_CTX_SIZE=32768
LLAMA_FLASH_ATTN=1
LLAMA_CHAT_TEMPLATE=auto

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# --- Hugging Face Hub (opcional; sube límites de descarga) ---
# HF_TOKEN=
HF_HUB_URL=https://huggingface.co

# --- UI ---
VITE_API_URL=http://localhost:3050

# --- Agent ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=