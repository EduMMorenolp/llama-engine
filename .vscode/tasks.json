{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "api: dev",
			"type": "npm",
			"script": "dev",
			"options": { "cwd": "${workspaceFolder}/engine-api" },
			"presentation": { "group": "api" }
		},
		{
			"label": "api: check",
			"type": "npm",
			"script": "check",
			"options": { "cwd": "${workspaceFolder}/engine-api" },
			"group": { "kind": "build", "isDefault": true }
		},
		{
			"label": "ui: dev",
			"type": "npm",
			"script": "dev",
			"options": { "cwd": "${workspaceFolder}/engine-ui" },
			"presentation": { "group": "ui" }
		},
		{
			"label": "ui: build",
			"type": "npm",
			"script": "build",
			"options": { "cwd": "${workspaceFolder}/engine-ui" },
			"group": "build"
		},
		{
			"label": "compose: up (api + ui fast)",
			"type": "shell",
			"command": "docker compose up -d --build --no-deps engine-api engine-ui-telemetry",
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "group": "infra", "reveal": "always" }
		},
		{
			"label": "compose: up (ui only)",
			"type": "shell",
			"command": "docker compose up -d --build --no-deps engine-ui-telemetry",
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "group": "infra", "reveal": "always" }
		},
		{
			"label": "compose: up (api only)",
			"type": "shell",
			"command": "docker compose up -d --build --no-deps engine-api",
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "group": "infra", "reveal": "always" }
		},
		{
			"label": "compose: up (all services)",
			"type": "shell",
			"command": "docker compose up -d --build",
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "group": "infra" }
		},
		{
			"label": "compose: ps",
			"type": "shell",
			"command": "docker compose ps",
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "group": "infra", "reveal": "always" }
		},
		{
			"label": "compose: logs (runtime)",
			"type": "shell",
			"command": "docker compose logs -f llama-runtime",
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "group": "infra", "reveal": "always" }
		},
		{
			"label": "compose: down",
			"type": "shell",
			"command": "docker compose down",
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "group": "infra" }
		}
	]
}