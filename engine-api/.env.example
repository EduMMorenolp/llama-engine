PORT=3050
API_KEY=llama-engine-dev

# URL del runtime llama-server (dentro de la red docker: http://llama-runtime:8080)
LLAMA_RUNTIME_URL=http://llama-runtime:8080
# Nombre del contenedor del runtime (para gestionarlo vía Dockerode)
LLAMA_RUNTIME_CONTAINER=llama-runtime

# Directorio de modelos montado (registro de GGUFs)
MODELS_DIR=/models

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000